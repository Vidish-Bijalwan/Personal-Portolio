# ── VILISH Studio — environment ──────────────────────────────────
# Copy to .env.local for development. Never commit real values.

# Database
DATABASE_URL=

# Worker cron auth — the /api/worker/poll route accepts this secret via
# the ?cron_secret= query parameter (Vercel cron paths cannot carry
# secrets, so configure your scheduled caller to append it).
CRON_SECRET=

# Admin dashboard token (sent as x-admin-token header; kept in memory only)
ADMIN_TOKEN=

# Payments: manual UPI (MVP — no gateway)
# Which payment provider the backend uses
PAYMENTS_PROVIDER=manual_upi
# Enable/disable manual UPI payments
UPI_PAYMENT_ENABLED=true
# VPA that customers pay to (placeholder — set the real one)
UPI_VPA=yourname@upi
UPI_PAYEE_NAME=VILISH
# Optional static QR image path/URL shown alongside generated QRs
UPI_QR_IMAGE=
# How long a manual payment order stays valid, in minutes
MANUAL_UPI_ORDER_TTL_MIN=30

# Provider: fal (image generation)
FAL_KEY=
# USD→INR rate used to convert provider costs
FAL_USD_INR=88

# Provider failover order, e.g. fal,meta,mock
GENERATION_PROVIDER_PRIORITY=fal,meta,mock
# Allow the mock provider (dev/testing only)
ALLOW_MOCK_PROVIDER=true

# Dev auth bypass (dev only)
DEV_AUTH=true

# Google OAuth (NextAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Output storage: local | s3
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Public site URL (used by sitemap.xml)
NEXT_PUBLIC_SITE_URL=
